# PM RAID Agent MVP - Environment Configuration
# Copy this file to .env and configure the required settings

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# The MVP supports one real LLM provider through a loosely coupled interface
# Provider-specific configuration is isolated behind the interface abstraction

# LLM Provider Selection (currently supported: 'openai')
LLM_PROVIDER=openai

# OpenAI Configuration (only loaded when OpenAI provider is selected and used)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.1

# =============================================================================
# Application Configuration
# =============================================================================

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=structured

# Streamlit Configuration
STREAMLIT_PORT=8501
STREAMLIT_HOST=localhost

# Document Processing Configuration
MAX_FILE_SIZE_MB=10
SUPPORTED_FORMATS=pdf,docx,xlsx

# =============================================================================
# Security Configuration
# =============================================================================
# API keys must be stored in environment variables, never hardcoded
# No persistent storage of uploaded documents beyond session
# Configuration uses lazy initialization - API key validated only when LLM is used

# Session Configuration
SESSION_CLEANUP=true
SESSION_TIMEOUT_MINUTES=60

# =============================================================================
# Development Configuration
# =============================================================================

# Debug Mode
DEBUG=false

# Test Configuration
TEST_MODE=false

# =============================================================================
# Notes
# =============================================================================
# - The application can be imported and basic configuration loaded without an API key
# - LLM provider credentials are validated only when the LLM is actually used
# - Provider-specific configuration is isolated behind the LLMProviderConfig interface
# - Future providers can be added by implementing the same interface
